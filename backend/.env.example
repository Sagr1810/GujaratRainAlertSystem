# Server
PORT=5000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gujarat_rain_db
DB_USER=root
DB_PASSWORD=your_mysql_password

# JWT
JWT_SECRET=gujarat_rain_secret_key_2024

# OpenWeatherMap API (Free tier — get from openweathermap.org)
OPENWEATHER_API_KEY=your_openweathermap_api_key

# IBM watsonx.ai Granite LLM
IBM_WATSON_API_KEY=your_ibm_watsonx_api_key
IBM_WATSON_URL=https://us-south.ml.cloud.ibm.com
IBM_WATSON_PROJECT_ID=your_project_id
IBM_GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
